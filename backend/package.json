{
  "name": "kikoeru-express",
  "type": "module",
  "version": "1.0.2",
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/kikoeru-project/kikoeru-express",
  "repository": {
    "type": "git",
    "url": "git@github.com:kikoeru-project/kikoeru-express.git"
  },
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node --trace-warnings app.ts",
    "dev": "node --watch --watch-path=auth --watch-path=database --watch-path=filesystem --watch-path=routes --watch-path=scraper --watch-path=scripts --watch-path=test --watch-path=app.ts --watch-path=api.ts --watch-path=asr.ts --watch-path=base-path.ts --watch-path=common.ts --watch-path=config.ts --watch-path=socket.ts --watch-path=suggest-track-titles.ts --watch-path=track-titles.ts --watch-path=transcribe-work.ts --watch-path=upgrade.ts --watch-path=work-id.ts --trace-warnings app.ts",
    "scan": "node --trace-warnings ./filesystem/scanner.ts",
    "backfill:progress": "node --trace-warnings ./scripts/backfill-progress.ts",
    "import:legacy-history": "node --trace-warnings ./scripts/import-legacy-history.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run lint && npm run typecheck && cross-env NODE_ENV=test mocha --extension ts 'test/**/*.ts' --ignore test/benchmark.ts --ignore 'test/{helpers,spinup,teardown}/**'",
    "bench": "cross-env NODE_ENV=test mocha --extension ts test/benchmark.ts"
  },
  "bin": "app.ts",
  "pkg": {
    "scripts": [
      "filesystem/scanner.js",
      "filesystem/updater.js",
      "filesystem/workFileScanner.js",
      "database/migrations/*.js"
    ],
    "assets": [
      "dist/**/*",
      "static/**/*",
      "scraper/tag-aliases.json"
    ],
    "outputPath": "package"
  },
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "umonaca <mw2010a@gmail.com>"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.0.0-rc.6",
    "compare-versions": "^6.1.1",
    "compression": "^1.7.4",
    "connect-history-api-fallback": "^1.6.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-validator": "^7.0.0",
    "jschardet": "^3.0.0",
    "knex": "^3.3.0",
    "mime-types": "^3.0.0",
    "natural-orderby": "^2.0.3",
    "socket.io": "^4.8.4",
    "tunnel-agent": "^0.6.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^4.3.4",
    "chai-string": "^1.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "mocha": "^12.0.3",
    "serve-index": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
