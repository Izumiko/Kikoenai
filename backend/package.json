{
  "name": "kikoeru-express",
  "type": "module",
  "version": "1.0.2",
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/kikoeru-project/kikoeru-express",
  "repository": {
    "type": "git",
    "url": "git@github.com:kikoeru-project/kikoeru-express.git"
  },
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node --trace-warnings app.ts",
    "start:bundle": "cross-env NODE_ENV=production node --trace-warnings build/app.mjs",
    "build": "node scripts/build.ts",
    "dev": "node --watch --watch-path=auth --watch-path=database --watch-path=filesystem --watch-path=lib --watch-path=routes --watch-path=scraper --watch-path=scripts --watch-path=test --watch-path=types --watch-path=app.ts --watch-path=api.ts --watch-path=asr.ts --watch-path=base-path.ts --watch-path=common.ts --watch-path=config.ts --watch-path=socket.ts --watch-path=suggest-track-titles.ts --watch-path=track-titles.ts --watch-path=transcribe-work.ts --watch-path=upgrade.ts --watch-path=work-id.ts --trace-warnings app.ts",
    "scan": "node --trace-warnings ./filesystem/scanner.ts",
    "backfill:progress": "node --trace-warnings ./scripts/backfill-progress.ts",
    "import:legacy-history": "node --trace-warnings ./scripts/import-legacy-history.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run lint && npm run typecheck && node --import ./test/setup-env.ts --test --test-concurrency=1 test/backfill-progress.ts test/base-path.ts test/data-root.ts test/description-html.ts test/edit-metadata.ts test/history-seconds.ts test/import-legacy-history.ts test/lib.ts test/lyric-discovery.ts test/migration-names.ts test/migration..ts test/node-sqlite-client.ts test/progress-projections.ts test/scan-logging.ts test/search-query.ts test/track-identity.ts test/track-progress-freshness.ts test/track-titles.ts test/transcode-filename.ts test/transcription.ts test/urljoin.ts test/work-file-listing.ts test/work-files.ts test/work-id.ts test/work-images.ts",
    "bench": "node --import ./test/setup-env.ts test/benchmark.ts",
    "test:bundle": "node --import ./test/setup-env.ts --test --test-concurrency=1 test/bundle-smoke.ts"
  },
  "bin": "app.ts",
  "pkg": {
    "scripts": [
      "filesystem/scanner.js",
      "filesystem/updater.js",
      "filesystem/workFileScanner.js",
      "database/migrations/*.js"
    ],
    "assets": [
      "dist/**/*",
      "static/**/*",
      "scraper/tag-aliases.json"
    ],
    "outputPath": "package"
  },
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "umonaca <mw2010a@gmail.com>"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.0.0-rc.6",
    "compare-versions": "^6.1.1",
    "compression": "^1.7.4",
    "connect-history-api-fallback": "^1.6.0",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-validator": "^7.0.0",
    "jschardet": "^3.0.0",
    "knex": "^3.3.0",
    "mime-types": "^3.0.0",
    "natural-orderby": "^2.0.3",
    "socket.io": "^4.8.4",
    "tunnel-agent": "^0.6.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/serve-index": "^1.9.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "serve-index": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
