# Build context excludes for `podman build` / `buildah build`.
#
# .containerignore (not .dockerignore): the published image is built by
# redhat-actions/buildah-build in .github/workflows/build.yml, and buildah
# prefers this filename. There is no Docker/BuildKit anywhere in the pipeline.
#
# The Containerfile builds everything itself: the build stage runs `npm ci` and
# then builds the frontend (into backend/dist) and bundles the backend (into
# backend/build). So the context has to carry both workspaces' sources and the
# root lockfile -- but no build output and no runtime data.

# Git
.git
.gitignore

# Node modules
# The build stage runs its own `npm ci` against Alpine (musl). A host
# node_modules in the context would overlay the Alpine install with binaries
# built for the host's libc. Listed per workspace rather than relying on the
# bare `node_modules` pattern, which only matches at the context root.
node_modules
backend/node_modules
frontend/node_modules
.pnp
.pnp.js

# Build artifacts
# Both are produced inside the image by the build stage; copying a host build
# in would only add stale chunks/WebApp files to the context. (backend/dist is
# gitignored, so CI never has one anyway.)
backend/build
backend/dist
.quasar

# Runtime data: secrets, and an entire library
# These live under backend/, not at the context root -- the earlier root-level
# `config/*` / `covers/* `/ `sqlite/*` patterns matched nothing at all, which is
# how a local build came to bake in a developer's config and database.
# config/config.json holds md5secret and jwtsecret; sqlite/ is the whole
# database; covers/ and images/ are the scraped image caches; transcodes/ and
# lyrics/ are the Opus cache and the generated-subtitle overlay. None are
# tracked in git, so CI never sees them -- but a fresh named volume mounted
# over a path that has content in the image is seeded from that content, so an
# operator's volume would come pre-populated with someone else's data.
backend/config
backend/sqlite
backend/covers
backend/images
backend/transcodes
backend/lyrics
backend/logs

# Media: the default library mount point.
# On a developer machine it holds real voice works.
backend/VoiceWork

# Tests
test-results
tests
backend/test
*.spec.*

# Root scripts -- never used by the image build
scripts

# Package output (scripts/package.js)
package

# VS Code
.vscode

# Env
.env
.env.*

# Logs
*.log
npm-debug.log*

# Docs
# Nothing reads markdown at runtime (checked: no route opens a .md file).
# LICENSE is deliberately NOT excluded -- it is not markdown, and the
# Containerfile copies it into the image explicitly. GPL-3.0 requires shipping
# it.
*.md
backend/*.md
frontend/*.md
docs

# GitHub
.github

# OS
.DS_Store
Thumbs.db
